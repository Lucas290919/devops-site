# =============================================================================
# backend/.env.example
#
# Copie este arquivo para backend/.env e preencha com valores reais.
# O arquivo .env NUNCA deve ser commitado no repositório.
#
# Gerar um JWT_SECRET forte:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# =============================================================================

# ─── MySQL ────────────────────────────────────────────────────
DB_HOST=mysql          # nome do serviço no docker-compose (não altere para uso local)
DB_PORT=3306
DB_USER=devops
DB_PASSWORD=troque-por-senha-forte
DB_NAME=devops_site

# ─── MySQL root (usado apenas pelo docker-compose para criar o container) ───
MYSQL_ROOT_PASSWORD=troque-por-senha-root-forte

# ─── JWT ──────────────────────────────────────────────────────
JWT_SECRET=troque-por-um-segredo-forte-em-producao
JWT_EXPIRES_IN=8h

# ─── Servidor ─────────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ─── CORS ─────────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost,http://localhost:80
