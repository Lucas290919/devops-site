# ─── MySQL ────────────────────────────────────────────────────
DB_HOST=mysql          # nome do serviço no docker-compose
DB_PORT=3306
DB_USER=devops
DB_PASSWORD=devops
DB_NAME=devops_site

# ─── JWT ──────────────────────────────────────────────────────
# Gere um segredo forte em produção:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=troque-por-um-segredo-forte-em-producao
JWT_EXPIRES_IN=8h

# ─── Servidor ─────────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ─── CORS ─────────────────────────────────────────────────────
# Origens permitidas (separadas por vírgula)
ALLOWED_ORIGINS=http://localhost,http://localhost:80

# ─────────────────────────────────────────────────────────────
# Copie este arquivo para .env e preencha com valores reais.
# Nunca commite o .env no repositório.
# ─────────────────────────────────────────────────────────────
